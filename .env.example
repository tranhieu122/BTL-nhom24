# ─── HE THONG QUAN LY DAT PHONG HOC – Nhom 24 ────────────────────────────────
# Sao chep file nay thanh ".env" va dien gia tri thuc vao.
# TUYET DOI KHONG commit file .env len Git (da duoc them vao .gitignore).

# ── Database (SQLite – mac dinh, khong can cau hinh) ─────────────────────────
# De trong se tu dong dung SQLite embedded (classroom_booking.db)
DB_ENGINE=sqlite

# ── Database (MySQL – bo comment neu muon dung MySQL) ─────────────────────────
# DB_ENGINE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password_here
# DB_NAME=classroom_booking

# ── Email (SMTP – dung de gui thong bao khi dat phong duoc duyet/tu choi) ─────
# Dang nhap app-password Gmail: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com
EMAIL_ENABLED=false

# ── Ung dung ─────────────────────────────────────────────────────────────────
APP_NAME=He Thong Quan Ly Dat Phong Hoc
APP_VERSION=2.0
