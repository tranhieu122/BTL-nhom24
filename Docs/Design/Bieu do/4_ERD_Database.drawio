d_at&lt;/td&gt;&lt;td&gt;TEXT DEFAULT datetime('now')&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#F9F0FF;strokeColor=#9B59B6;rounded=1;" vertex="1" parent="1">
